# POS Application Configuration
# Copy this file to .env and fill in your actual values
# NOTE: .env is in .gitignore and should NEVER be committed to the repository

# HTTPS/Security
ENABLE_HTTPS=true
NODE_ENV=production

# Optional: If using self-signed certificates for development
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# Application
PORT=3000
HOST=0.0.0.0

# Optional: API Base URL (for cross-origin requests)
# API_BASE_URL=https://api.example.com

# Optional: Enable debug logging
DEBUG=false
